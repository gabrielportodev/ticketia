TICKETIA_PORT=3000
TICKETIA_API_URL=http://127.0.0.1:8080

TICKETIA_DB_NAME=ticketia
TICKETIA_DB_USER=ticketia
TICKETIA_DB_PASSWORD=ticketia_local
TICKETIA_RABBITMQ_USER=ticketia
TICKETIA_RABBITMQ_PASSWORD=ticketia_local

TICKETIA_AI_API_KEY=
TICKETIA_GROQ_MODEL=openai/gpt-oss-20b
TICKETIA_GROQ_BASE_URL=https://api.groq.com/openai/v1

